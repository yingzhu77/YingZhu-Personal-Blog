---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const config = {
	...commentConfig.waline,
	el: "#waline",
	path: Astro.props.path,
	dark: "html.dark",

	...(commentConfig.waline?.visitorCount ? { pageview: true } : {}),
};
---
<!-- Waline -->
<div class="relative w-full">
  <div id="waline"></div>
  <div id="waline-loading" class="waline-loading">
    <div class="waline-loading-item"></div>
    <div class="waline-loading-item short"></div>
    <div class="waline-loading-item"></div>
    <div class="waline-loading-item medium"></div>
  </div>
  <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
  <script type="module" is:inline define:vars={{ config }}>
    const loading = document.getElementById('waline-loading');

    function hideLoading() {
      if (loading) {
        loading.style.display = 'none';
      }
    }

    // 立即隐藏自定义加载动画
    hideLoading();

    import('https://unpkg.com/@waline/client@v3/dist/waline.js').then(({ init }) => {
      init(config);

      // 监听 Waline 容器变化，隐藏 Waline 自身的加载动画
      const observer = new MutationObserver(() => {
        const walineEl = document.getElementById('waline');
        if (!walineEl) return;

        // 检测 Waline 是否加载完成（出现评论卡片或空状态）
        const hasContent = walineEl.querySelector('.wl-card, .wl-empty');
        const hasLoading = walineEl.querySelector('.wl-loading');

        if (hasContent || hasLoading) {
          // 如果有内容或加载完成，隐藏 Waline 的加载动画
          if (hasLoading) {
            hasLoading.style.display = 'none';
          }
          observer.disconnect();
        }
      });

      const walineEl = document.getElementById('waline');
      if (walineEl) {
        observer.observe(walineEl, { childList: true, subtree: true });
      }

      // 超时保护：3秒后强制隐藏所有加载动画
      setTimeout(() => {
        hideLoading();
        const walineLoading = document.querySelector('#waline .wl-loading');
        if (walineLoading) {
          walineLoading.style.display = 'none';
        }
        observer.disconnect();
      }, 3000);
    }).catch(() => {
      // 加载失败时隐藏加载动画
      hideLoading();
    });
  </script>
</div>

<style>
  .waline-loading {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 0;
  }
  .waline-loading-item {
    height: 0.875rem;
    border-radius: 0.375rem;
    background: linear-gradient(90deg, var(--btn-regular-bg) 25%, oklch(from var(--btn-regular-bg) calc(l + 0.05) c h) 50%, var(--btn-regular-bg) 75%);
    background-size: 200% 100%;
    animation: waline-shimmer 1.5s ease-in-out infinite;
  }
  .waline-loading-item.short { width: 40%; }
  .waline-loading-item.medium { width: 70%; }
  @keyframes waline-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>