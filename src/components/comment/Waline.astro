---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const config = {
	...commentConfig.waline,
	el: "#waline",
	path: Astro.props.path,
	dark: "html.dark",

	...(commentConfig.waline?.visitorCount ? { pageview: true } : {}),
};
---
<!-- Waline -->
<div class="relative w-full">
  <div id="waline"></div>
  <div id="waline-loading" class="waline-loading">
    <div class="waline-loading-item"></div>
    <div class="waline-loading-item short"></div>
    <div class="waline-loading-item"></div>
    <div class="waline-loading-item medium"></div>
  </div>
  <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
  <script type="module" is:inline define:vars={{ config }}>
    const loading = document.getElementById('waline-loading');
    import('https://unpkg.com/@waline/client@v3/dist/waline.js').then(({ init }) => {
      init(config);
      const observer = new MutationObserver(() => {
        const walineEl = document.getElementById('waline');
        if (walineEl && walineEl.children.length > 0) {
          if (loading) loading.style.display = 'none';
          observer.disconnect();
        }
      });
      const walineEl = document.getElementById('waline');
      if (walineEl) observer.observe(walineEl, { childList: true });
    });
  </script>
</div>

<style>
  .waline-loading {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 0;
  }
  .waline-loading-item {
    height: 0.875rem;
    border-radius: 0.375rem;
    background: linear-gradient(90deg, var(--btn-regular-bg) 25%, oklch(from var(--btn-regular-bg) calc(l + 0.05) c h) 50%, var(--btn-regular-bg) 75%);
    background-size: 200% 100%;
    animation: waline-shimmer 1.5s ease-in-out infinite;
  }
  .waline-loading-item.short { width: 40%; }
  .waline-loading-item.medium { width: 70%; }
  @keyframes waline-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>