---
import { musicPlayerConfig } from "@/config/musicConfig";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "音乐分享";
const description = "戴上耳机，进入另一个世界";

const meting = musicPlayerConfig.meting;
const local = musicPlayerConfig.local;
const isLocal = musicPlayerConfig.mode === "local";
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 py-6 md:px-9 w-full">
      <div class="flex items-center justify-between gap-3 mb-2">
        <div class="flex items-center gap-3">
          <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
            <span class="text-[1.25rem] leading-none select-none">🎵</span>
          </div>
          <h2 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
            音乐分享
          </h2>
        </div>
        <a href="/share/" class="btn-plain scale-animation rounded-lg px-3 py-2 text-sm text-(--primary) hover:bg-(--btn-regular-bg) transition-colors flex items-center gap-1">
          <span>← 分享</span>
        </a>
      </div>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-2">
        戴上耳机，进入另一个世界。
      </p>
      <p class="text-xs text-neutral-400 dark:text-neutral-500 mb-6">
        控制面板在侧边栏中，调节音量或切换歌曲会更加方便。
      </p>

      <!-- 当前播放列表信息 -->
      <div class="p-4 rounded-lg bg-(--btn-regular-bg) mb-6">
        <h3 class="text-sm font-semibold mb-2">
          {isLocal ? "当前模式：本地音乐" : `当前平台：${meting?.server === "netease" ? "网易云音乐" : meting?.server === "tencent" ? "QQ音乐" : meting?.server || "未知"}`}
        </h3>
        {isLocal && (
          <div class="contents">
            <p class="text-xs text-neutral-500">共 {local?.playlist?.length ?? 0} 首本地歌曲</p>
            {local?.playlist && local.playlist.length > 0 && (
              <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mt-3">
                {local.playlist.map((song) => (
                  <div class="flex items-center gap-2 p-2 rounded-md bg-(--card-bg) border border-(--line-divider)">
                    {song.cover ? (
                      <img src={song.cover} alt={song.name} class="w-10 h-10 rounded object-cover" loading="lazy" />
                    ) : (
                      <div class="w-10 h-10 rounded bg-(--btn-regular-bg) flex items-center justify-center text-xs text-neutral-400">♪</div>
                    )}
                    <div class="min-w-0">
                      <p class="text-xs font-medium truncate">{song.name}</p>
                      <p class="text-[0.65rem] text-neutral-400 truncate">{song.artist}</p>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}
        {!isLocal && (
          <div class="contents">
            <p class="text-xs text-neutral-500">
              {meting?.type === "playlist" ? "歌单" : meting?.type === "album" ? "专辑" : "歌曲"} ID：{meting?.id}
            </p>
            <p class="text-xs text-neutral-400 mt-1">音乐数据由 Meting API 动态获取，在侧边栏音乐播放器中查看完整列表。</p>
          </div>
        )}
      </div>

      <!-- 内嵌音乐播放器 -->
      <div class="max-w-md mx-auto">
        <MusicPlayer />
      </div>
    </div>
  </div>
</MainGridLayout>
