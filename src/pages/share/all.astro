---
import { getImage } from "astro:assets";
import AllImagesGallery from "@/components/pages/share/AllImagesGallery.svelte";
import { backgroundWallpaper } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "全部壁纸";
const description = "浏览所有博客壁纸图片";

// 直接扫描文件夹中所有图片（不依赖 config）
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/images/wallpapers/*.{avif,webp,jpg,jpeg,png}",
);

interface WallpaperData {
	name: string;
	hue: number;
	desktopPath: string;
	mobilePath: string;
	thumbnailUrl: string;
	fullUrl: string;
	artist?: string;
}

const hueMap = backgroundWallpaper.wallpaperHue?.imageHueMap ?? {};
const wallpaperItems: WallpaperData[] = [];
const imageEntries = Object.entries(imageModules).sort(([a], [b]) =>
	a.localeCompare(b),
);

for (const [filePath, loader] of imageEntries) {
	const fileName =
		filePath
			.split("/")
			.pop()
			?.replace(/\.[^/.]+$/, "") ?? "";
	if (!fileName) continue;

	const mod = await loader();
	const img = mod.default;
	const thumb = await getImage({
		src: img,
		width: 480,
		format: "webp",
		quality: 80,
	});
	const full = await getImage({
		src: img,
		width: 1920,
		format: "webp",
		quality: 85,
	});

	wallpaperItems.push({
		name: fileName,
		hue: hueMap[fileName] ?? 250,
		desktopPath: `assets/images/wallpapers/${filePath.split("/").pop()}`,
		mobilePath: `assets/images/wallpapers/${filePath.split("/").pop()}`,
		thumbnailUrl: thumb.src,
		fullUrl: full.src,
	});
}
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 py-6 md:px-9 w-full">
      <div class="flex items-center justify-between gap-3 mb-2">
        <div class="flex items-center gap-3">
          <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
            <span class="text-[1.25rem] leading-none select-none">🖼</span>
          </div>
          <h2 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
            全部壁纸
          </h2>
        </div>
        <a
          href="/share/"
          class="btn-plain scale-animation rounded-lg px-3 py-2 text-sm text-(--primary) hover:bg-(--btn-regular-bg) transition-colors flex items-center gap-1"
        >
          <span>← 分享</span>
        </a>
      </div>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-2">
        收录了对上我电波的美图，适合当壁纸、美化等。希望看到图片的你也能放松下来！
      </p>
      <p class="text-xs text-neutral-400 dark:text-neutral-500 mb-4">
        赞美伟大的画师们！会持续更新（原谅我实在懒得列画师名了）。图片源自网络，侵权联系我进行删除。
      </p>

      <AllImagesGallery
        wallpapers={wallpaperItems}
        client:visible
      />
    </div>
  </div>
</MainGridLayout>
