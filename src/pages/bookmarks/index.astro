---
import { Icon } from "astro-icon/components";
import { bookmarks } from "@/config/bookmarksConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = i18n(I18nKey.bookmarks);
const description = "我收藏的工具、教程与开源项目";
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 py-6 md:px-9 w-full">
      <div class="flex items-center gap-3 mb-6">
        <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
          <Icon name="material-symbols:bookmark-outline" class="text-[1.5rem]" />
        </div>
        <h2 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
          {title}
        </h2>
      </div>

      {
        bookmarks.length === 0 ? (
          <div class="text-center py-16 text-neutral-500">
            <Icon name="material-symbols:bookmark-outline" class="text-[3rem] mx-auto mb-4 block opacity-40" />
            <p>暂无收藏</p>
          </div>
        ) : (
          <div class="flex flex-col gap-6">
            {(["工具", "教程", "开源项目"] as const).map((category) => {
              const items = bookmarks.filter((b) => b.category === category);
              if (items.length === 0) return null;
              return (
                <section>
                  <h3 class="text-sm font-semibold text-(--primary) mb-3 uppercase tracking-wide">
                    {category}
                  </h3>
                  <div class="flex flex-col gap-2">
                    {items.map((item) => (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex items-start gap-3 px-4 py-3 rounded-lg border border-(--line-divider) hover:border-(--primary)/30 hover:bg-(--primary)/[0.04] transition-colors"
                      >
                        <div class="shrink-0 mt-0.5 text-(--primary)/60 group-hover:text-(--primary) transition-colors">
                          {item.category === "工具" ? (
                            <Icon name="material-symbols:build" class="text-[1.15rem]" />
                          ) : item.category === "教程" ? (
                            <Icon name="material-symbols:book-2-outline" class="text-[1.15rem]" />
                          ) : (
                            <Icon name="material-symbols:code-blocks" class="text-[1.15rem]" />
                          )}
                        </div>
                        <div class="min-w-0 flex-1">
                          <div class="flex items-center gap-2">
                            <span class="font-medium text-sm text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors truncate">
                              {item.title}
                            </span>
                            <Icon name="material-symbols:arrow-outward" class="shrink-0 text-[0.85rem] text-neutral-400 dark:text-neutral-500 opacity-0 group-hover:opacity-100 transition-opacity" />
                          </div>
                          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 leading-relaxed">
                            {item.description}
                          </p>
                        </div>
                      </a>
                    ))}
                  </div>
                </section>
              );
            })}
          </div>
        )
      }
    </div>
  </div>
</MainGridLayout>
