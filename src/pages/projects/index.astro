---
import { Icon } from "astro-icon/components";
import { projects } from "@/config/projectsConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = i18n(I18nKey.projects);
const description = "我参与和创建的开源项目";
// 新项目在上，旧项目在下（反转数组顺序）
const sortedProjects = [...projects].reverse();
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 py-6 md:px-9 w-full">
      <div class="flex items-center gap-3 mb-6">
        <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
          <Icon name="material-symbols:code-blocks" class="text-[1.5rem]" />
        </div>
        <h2 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
          {title}
        </h2>
      </div>

      {
        sortedProjects.length === 0 ? (
          <div class="text-center py-16 text-neutral-500">
            <Icon name="material-symbols:folder-open-outline" class="text-[3rem] mx-auto mb-4 block opacity-40" />
            <p>暂无项目展示</p>
          </div>
        ) : (
          <div class="flex flex-col gap-4">
            {sortedProjects.map((project) => (
              <div class="project-card card-base group border border-(--line-divider) rounded-(--radius-large) hover:border-(--primary)/30 transition-all duration-300 hover:shadow-lg">
                <div class="p-5 md:p-6 flex flex-col gap-4">
                  <!-- 项目头部：Logo + 标题 + GitHub 图标，同行并排 -->
                  <div class="flex items-center gap-3">
                    {project.logo && (
                      <a
                        href={project.website || project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="shrink-0"
                      >
                        <img
                          src={project.logo}
                          alt={project.name}
                          class="w-9 h-9 rounded-lg object-cover border border-black/5 dark:border-white/10 group-hover:scale-105 transition-transform duration-300"
                          loading="lazy"
                        />
                      </a>
                    )}
                    <a
                      href={project.website || project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex-1 min-w-0 hover:text-(--primary) transition-colors"
                    >
                      <h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors leading-snug truncate">
                        {project.name}
                      </h3>
                    </a>
                    <div class="flex items-center gap-1 shrink-0">
                      {project.website && (
                        <a
                          href={project.website}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-plain scale-animation rounded-lg h-9 w-9 flex items-center justify-center text-neutral-400 hover:text-(--primary) transition-colors"
                          aria-label={`Visit ${project.name} website`}
                        >
                          <Icon name="material-symbols:globe" class="text-[1.15rem]" />
                        </a>
                      )}
                      <a
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-plain scale-animation rounded-lg h-9 w-9 flex items-center justify-center text-neutral-400 hover:text-(--primary) transition-colors"
                        aria-label={`View ${project.name} on GitHub`}
                      >
                        <Icon name="fa7-brands:github" class="text-[1.25rem]" />
                      </a>
                    </div>
                  </div>

                  <!-- 描述 -->
                  <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-3">
                    {project.description}
                  </p>

                  <!-- 元信息 + 标签 -->
                  <div class="flex flex-wrap items-center gap-3">
                    {project.language && (
                      <span class="flex items-center gap-1 text-xs text-neutral-500 dark:text-neutral-400">
                        <span class="w-2.5 h-2.5 rounded-full bg-(--primary) inline-block"></span>
                        {project.language}
                      </span>
                    )}
                    {project.stars !== undefined && (
                      <span class="flex items-center gap-1 text-xs text-neutral-500 dark:text-neutral-400">
                        <Icon name="material-symbols:star-outline" class="text-[0.9rem]" />
                        {project.stars}
                      </span>
                    )}
                    <div class="flex flex-wrap gap-1.5">
                      {project.tags.map((tag) => (
                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-(--primary)/10 text-(--primary) border border-(--primary)/20">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</MainGridLayout>

<style is:global>
  .project-card {
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
  }
</style>
